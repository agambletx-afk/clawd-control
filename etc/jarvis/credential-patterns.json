{
  "version": 1,
  "patterns": [
    { "name": "OpenAI API Key", "regex": "sk-[a-zA-Z0-9]{20,}" },
    { "name": "GitHub PAT (classic)", "regex": "ghp_[a-zA-Z0-9]{36}" },
    { "name": "GitHub PAT (fine-grained)", "regex": "github_pat_[a-zA-Z0-9_]{20,}" },
    { "name": "Anthropic API Key", "regex": "sk-ant-[a-zA-Z0-9-]{20,}" },
    { "name": "Google API Key", "regex": "AIza[a-zA-Z0-9_-]{35}" },
    { "name": "Generic secret assignment", "regex": "(?:password|secret|token|api_key)\\s*[:=]\\s*[\"']?\\S{8,}" }
  ]
}

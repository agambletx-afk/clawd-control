      "heartbeat_file": "/tmp/heartbeat-memory-root.json",
      "cadence_seconds": 86400,
      "cadence_minutes": 1440,
      "log_file": null,
      "auto_discovered": true,
      "discovered_at": "2026-04-01T15:27:43Z",
      "wrapper_path": "/usr/local/bin/memory-root-heartbeat-wrapper.sh",
